                            <Expression name="lit3">[BATTERY_PERCENT] &gt; 40 &amp;&amp; [BATTERY_PERCENT] &lt;= 60</Expression>
                            <Expression name="lit2">[BATTERY_PERCENT] &gt; 20 &amp;&amp; [BATTERY_PERCENT] &lt;= 40</Expression>
                        </Expressions>
                        <Compare expression="lit5">
                            <PartImage x="22" y="0" width="44" height="20">
                                <Image resource="battery_5" />
                            </PartImage>
                        </Compare>
                        <Compare expression="lit4">
                            <PartImage x="22" y="0" width="44" height="20">
                                <Image resource="battery_4" />
                            </PartImage>
                        </Compare>
                        <Compare expression="lit3">
                            <PartImage x="22" y="0" width="44" height="20">
                                <Image resource="battery_3" />
                            </PartImage>
                        </Compare>
                        <Compare expression="lit2">
                            <PartImage x="22" y="0" width="44" height="20">
                                <Image resource="battery_2" />
                            </PartImage>
                        </Compare>
                        <Default>
                            <PartImage x="22" y="0" width="44" height="20">
                                <Image resource="battery_1" />
                            </PartImage>
                        </Default>
                    </Condition>
                    <PartText x="0" y="25" width="88" height="19">
                        <Text align="CENTER">
                            <BitmapFont family="battery_percent" size="18">
                                <Template>%s%s<Parameter expression="[BATTERY_PERCENT]" />
                                    <Parameter expression="&quot;%&quot;" />
                                </Template>
                            </BitmapFont>
                        </Text>
                    </PartText>
                </Default>
            </Condition>
        </Group>
